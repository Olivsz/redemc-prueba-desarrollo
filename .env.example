# Copiá este archivo como .env y completá los valores.
# El .env nunca se sube al repositorio.

# Conexión de la aplicación a MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=redemc
DB_USER=redemc
DB_PASSWORD=cambiar-esta-clave

# Solo para el contenedor de MySQL local
DB_ROOT_PASSWORD=cambiar-esta-clave-root
